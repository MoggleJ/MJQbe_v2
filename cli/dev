#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$PROJECT_ROOT/docker-compose.yml"
COMPOSE_PROD_FILE="$PROJECT_ROOT/docker-compose.prod.yml"
COMPOSE_DEV_FILE="$PROJECT_ROOT/docker-compose.dev.yml"
ENV_FILE="$PROJECT_ROOT/.env"
CONFIG_FILE="$PROJECT_ROOT/config/config.yml"

# Si Docker n'est pas accessible mais que l'user est dans le groupe docker,
# ré-exécuter avec sg docker pour activer le groupe sans se reconnecter.
if ! docker info &>/dev/null 2>&1 && id -nG 2>/dev/null | grep -qw docker; then
    exec sg docker "$0" "$@"
fi

_read_yaml() {
    local key="$1" default="$2"
    local val
    val=$(grep -E "^\s*${key}:" "$CONFIG_FILE" 2>/dev/null | awk -F': ' '{print $2}' | tr -d '"' | xargs)
    echo "${val:-$default}"
}
export SERVER_NAME WEB_PORT API_PORT
SERVER_NAME="$(_read_yaml domain _)"
WEB_PORT="$(_read_yaml web_port 4444)"
API_PORT="$(_read_yaml api_port 4848)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()    { echo -e "${BLUE}[dev]${NC} $*"; }
success() { echo -e "${GREEN}[dev]${NC} $*"; }
warn()    { echo -e "${YELLOW}[dev]${NC} $*"; }
error()   { echo -e "${RED}[dev]${NC} $*" >&2; }

require_env() {
    if [[ ! -f "$ENV_FILE" ]]; then
        warn ".env not found — copie depuis .env.example"
        cp "$PROJECT_ROOT/.env.example" "$ENV_FILE"
        warn "Édite $ENV_FILE avant de lancer les services."
    fi
}

_compose()      { docker compose -f "$COMPOSE_FILE" "$@"; }
_compose_prod() { docker compose -f "$COMPOSE_FILE" -f "$COMPOSE_PROD_FILE" "$@"; }
_compose_dev()  { docker compose -f "$COMPOSE_FILE" -f "$COMPOSE_DEV_FILE" "$@"; }

cmd_up() {
    require_env
    info "Nettoyage des conteneurs résiduels..."
    _compose_prod down --remove-orphans 2>/dev/null || true
    _compose_dev  down --remove-orphans 2>/dev/null || true
    info "Démarrage des services (prod)..."
    _compose_prod --env-file "$ENV_FILE" up -d --build --force-recreate
    success "Services démarrés → http://localhost:${WEB_PORT}"
}

cmd_down() {
    info "Arrêt des services..."
    _compose_prod down --remove-orphans 2>/dev/null || true
    _compose_dev  down --remove-orphans 2>/dev/null || true
    success "Services arrêtés."
}

cmd_watch() {
    require_env
    info "Nettoyage des conteneurs résiduels..."
    _compose_prod down --remove-orphans 2>/dev/null || true
    _compose_dev  down --remove-orphans 2>/dev/null || true
    info "Démarrage en mode WATCH (hot-reload)..."
    info "  Frontend : Vite HMR  → http://localhost:${WEB_PORT}"
    info "  API      : uvicorn --reload"
    info "  Ctrl+C pour arrêter"
    _compose_dev --env-file "$ENV_FILE" up --build --force-recreate
}

cmd_restart() {
    local service="${1:-}"
    if [[ -n "$service" ]]; then
        info "Redémarrage du service : $service"
        _compose restart "$service"
    else
        info "Redémarrage de tous les services..."
        _compose restart
    fi
    success "Done."
}

cmd_logs() {
    local level="" service=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--level) level="$2"; shift 2 ;;
            *) service="$1"; shift ;;
        esac
    done

    local -a args=(logs -f --tail=200)
    [[ -n "$service" ]] && args+=("$service")

    if [[ -z "$level" ]]; then
        _compose "${args[@]}"
        return
    fi

    # Filter by severity keyword (case-insensitive). error ⊂ warning ⊂ info.
    local pattern
    case "$level" in
        error)   pattern='error|exception|traceback|critical|fatal|panic' ;;
        warning) pattern='error|exception|traceback|critical|fatal|panic|warn' ;;
        info)    pattern='error|warn|info' ;;
        *) error "niveau inconnu : $level (error|warning|info)"; return 1 ;;
    esac
    _compose "${args[@]}" 2>&1 | grep -Ei --line-buffered "$pattern"
}

cmd_status() {
    info "État des services :"
    _compose ps
}

cmd_db() {
    require_env
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    info "Connexion à PostgreSQL..."
    _compose exec db psql -U "${POSTGRES_USER:-mjqbe}" -d "${POSTGRES_DB:-mjqbe}"
}

cmd_shell() {
    local service="${1:-api}"
    info "Shell dans le service : $service"
    _compose exec "$service" /bin/sh
}

cmd_update() {
    info "Pull des dernières images et rebuild..."
    _compose pull
    _compose up -d --build --force-recreate
    success "Mise à jour terminée."
}

cmd_health() {
    info "Vérification de la santé des services..."
    local all_ok=true
    while IFS= read -r line; do
        if echo "$line" | grep -q "healthy\|running"; then
            echo -e "  ${GREEN}✓${NC} $line"
        elif echo "$line" | grep -q "unhealthy\|exited\|dead"; then
            echo -e "  ${RED}✗${NC} $line"
            all_ok=false
        else
            echo -e "  ${YELLOW}?${NC} $line"
        fi
    done < <(_compose ps --format "table {{.Name}}\t{{.Status}}" 2>/dev/null | tail -n +2)

    # Connectivité base de données
    # shellcheck source=/dev/null
    [[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
    if _compose exec -T db pg_isready -U "${POSTGRES_USER:-mjqbe}" -d "${POSTGRES_DB:-mjqbe}" &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} PostgreSQL accepte les connexions"
    else
        echo -e "  ${RED}✗${NC} PostgreSQL injoignable"
        all_ok=false
    fi

    # API HTTP
    if curl -fsS -o /dev/null "http://localhost:${API_PORT}/health" 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} API /health (port ${API_PORT})"
    else
        echo -e "  ${YELLOW}?${NC} API /health injoignable (port ${API_PORT})"
    fi

    if $all_ok; then
        success "Tous les services sont sains."
    else
        error "Certains services ne sont pas sains."
        return 1
    fi
}

cmd_gpio() {
    local pin="${1:-}" val="${2:-}"
    if [[ -z "$pin" || -z "$val" ]]; then
        error "Usage: dev gpio <pin> <0|1>"
        return 1
    fi
    info "GPIO ${pin} → ${val} (via API POST /dev/gpio)"
    curl -fsS -X POST "http://localhost:${API_PORT}/dev/gpio" \
        -H 'Content-Type: application/json' \
        -d "{\"pin\": ${pin}, \"value\": ${val}}" && echo
}

cmd_relay() {
    local relay="${1:-}" state="${2:-}"
    if [[ -z "$relay" || -z "$state" ]]; then
        error "Usage: dev relay <1-4> <0|1>"
        return 1
    fi
    info "Relais ${relay} → ${state} (via API POST /dev/relay)"
    curl -fsS -X POST "http://localhost:${API_PORT}/dev/relay" \
        -H 'Content-Type: application/json' \
        -d "{\"relay\": ${relay}, \"state\": ${state}}" && echo
}

# ---------------------------------------------------------------------------
# App native (processus locaux, hors Docker)
# ---------------------------------------------------------------------------
NATIVE_CORE_BIN="$PROJECT_ROOT/native/core/target/release/mjqbe-core"
NATIVE_UI_BIN="$PROJECT_ROOT/native/ui/build/mjqbe-native"
NATIVE_SOCK="${MJQBE_NATIVE_SOCKET:-/tmp/mjqbe-native.sock}"

cmd_native() {
    local action="${1:-help}"
    # shellcheck source=/dev/null
    [[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
    command -v cargo >/dev/null || { [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"; }

    case "$action" in
        build)
            info "Build core (cargo release)..."
            ( cd "$PROJECT_ROOT/native/core" && cargo build --release )
            info "Build UI (cmake release)..."
            cmake -S "$PROJECT_ROOT/native/ui" -B "$PROJECT_ROOT/native/ui/build" -DCMAKE_BUILD_TYPE=Release
            cmake --build "$PROJECT_ROOT/native/ui/build" --parallel
            success "Binaries : $NATIVE_CORE_BIN , $NATIVE_UI_BIN"
            ;;
        start)
            [[ -x "$NATIVE_CORE_BIN" ]] || { error "core absent — 'dev native build' d'abord"; return 1; }
            info "Démarrage mjqbe-core (socket $NATIVE_SOCK)..."
            MJQBE_NATIVE_SOCKET="$NATIVE_SOCK" \
            DATABASE_URL="postgres://${POSTGRES_USER:-mjqbe}:${POSTGRES_PASSWORD:-mjqbe}@localhost:${MJQBE_DB_HOST_PORT:-15432}/${POSTGRES_DB:-mjqbe}?sslmode=disable" \
                nohup "$NATIVE_CORE_BIN" >/tmp/mjqbe-core.log 2>&1 &
            echo $! > /tmp/mjqbe-core.pid
            sleep 1
            if [[ -x "$NATIVE_UI_BIN" ]]; then
                info "Démarrage mjqbe-native (UI)..."
                MJQBE_NATIVE_SOCKET="$NATIVE_SOCK" nohup "$NATIVE_UI_BIN" >/tmp/mjqbe-native.log 2>&1 &
                echo $! > /tmp/mjqbe-native.pid
            fi
            success "Native démarré (logs : /tmp/mjqbe-core.log, /tmp/mjqbe-native.log)"
            ;;
        stop)
            for p in /tmp/mjqbe-native.pid /tmp/mjqbe-core.pid; do
                [[ -f "$p" ]] && kill "$(cat "$p")" 2>/dev/null && rm -f "$p"
            done
            pkill -x mjqbe-core 2>/dev/null || true
            pkill -x mjqbe-native 2>/dev/null || true
            success "Native arrêté."
            ;;
        *)
            echo "Usage: dev native <build|start|stop>"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Sauvegarde / restauration PostgreSQL
# ---------------------------------------------------------------------------
cmd_backup() {
    require_env
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    mkdir -p "$PROJECT_ROOT/backups"
    local out="$PROJECT_ROOT/backups/mjqbe-$(date +%Y%m%d-%H%M%S).sql.gz"
    info "Dump de la base ${POSTGRES_DB:-mjqbe}..."
    _compose exec -T db pg_dump -U "${POSTGRES_USER:-mjqbe}" -d "${POSTGRES_DB:-mjqbe}" --clean --if-exists \
        | gzip > "$out"
    success "Sauvegarde : $out ($(du -h "$out" | cut -f1))"
}

cmd_restore() {
    local file="${1:-}"
    [[ -f "$file" ]] || { error "Fichier introuvable : $file"; return 1; }
    require_env
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    warn "Restauration de $file dans ${POSTGRES_DB:-mjqbe} — les données actuelles seront écrasées."
    read -rp "Continuer ? [y/N] " ans
    [[ "$ans" == "y" || "$ans" == "Y" ]] || { info "Annulé."; return 0; }
    if [[ "$file" == *.gz ]]; then
        gunzip -c "$file" | _compose exec -T db psql -U "${POSTGRES_USER:-mjqbe}" -d "${POSTGRES_DB:-mjqbe}"
    else
        _compose exec -T db psql -U "${POSTGRES_USER:-mjqbe}" -d "${POSTGRES_DB:-mjqbe}" < "$file"
    fi
    success "Restauration terminée."
}

# ---------------------------------------------------------------------------
# Workflow de sprint (agents/sprint-workflow.md)
# ---------------------------------------------------------------------------
cmd_sprint() {
    local push=false
    [[ "${1:-}" == "--push" ]] && push=true

    info "=== Workflow de sprint ==="
    command -v cargo >/dev/null || { [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"; }

    local ok=true
    info "1/4 — Tests core Rust"
    if [[ -f "$PROJECT_ROOT/native/core/Cargo.toml" ]] && command -v cargo >/dev/null; then
        ( cd "$PROJECT_ROOT/native/core" && cargo test --quiet ) || ok=false
    else
        warn "cargo indisponible — étape ignorée"
    fi

    info "2/4 — Tests API (pytest dans le conteneur api)"
    _compose exec -T api sh -c 'cd /app && python -m pytest -q' 2>/dev/null || warn "pytest non exécuté (conteneur api ?)"

    info "3/4 — Build + tests frontend (Docker)"
    docker build "$PROJECT_ROOT/frontend" --target builder -t mjqbe-fe-check >/dev/null 2>&1 \
        && docker run --rm mjqbe-fe-check sh -c 'npx tsc --noEmit && npx vitest run' \
        || { warn "front-check échoué"; ok=false; }

    info "4/4 — Santé des services"
    cmd_health || ok=false

    if $ok; then
        success "Workflow OK."
        $push && { git -C "$PROJECT_ROOT" push origin dev && info "Poussé sur origin/dev"; }
    else
        error "Des étapes ont échoué — corriger avant de pousser."
        return 1
    fi
}

cmd_install() {
    local target="/usr/local/bin/dev"
    local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
    info "Installation de '$self' → $target"
    if [[ -w "$(dirname "$target")" ]]; then
        ln -sf "$self" "$target"
    else
        info "Nécessite les droits admin :"
        echo "    sudo ln -sf '$self' '$target'"
        sudo ln -sf "$self" "$target" 2>/dev/null || return 0
    fi
    success "Installé — 'dev help' disponible partout."
}

cmd_help() {
    cat <<EOF
Usage: dev <commande> [options]

Services Docker (web) :
  up                     Build et démarre tous les services (prod)
  watch                  Mode hot-reload (Vite HMR + uvicorn --reload)
  down                   Arrête et supprime les conteneurs
  restart [service]      Redémarre tous les services ou un seul
  update                 Pull + rebuild + restart
  status                 État des conteneurs
  health                 Santé de chaque service + connectivité DB + API /health
  logs [service] [-l LVL]  Logs en direct ; LVL = error | warning | info
  db                     Shell psql dans le conteneur db
  shell [service]        Shell dans un conteneur (défaut : api)

Base de données :
  backup                 Dump PostgreSQL gzip daté → backups/
  restore <fichier>      Restaure un dump (.sql ou .sql.gz)

App native (hors Docker) :
  native build           Compile core (cargo release) + UI (cmake release)
  native start|stop      Démarre / arrête mjqbe-core (+ mjqbe-native)

Matériel (via l'API → daemon C) :
  gpio <pin> <0|1>       Écrit une broche GPIO
  relay <1-4> <0|1>      Commute un relais

Agents / workflow :
  sprint [--push]        Lance le workflow de sprint (tests core+api+front, health)
  install                Installe 'dev' dans /usr/local/bin
  help                   Affiche ce message

EOF
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    up)       cmd_up "$@" ;;
    watch)    cmd_watch "$@" ;;
    down)     cmd_down "$@" ;;
    restart)  cmd_restart "$@" ;;
    logs)     cmd_logs "$@" ;;
    status)   cmd_status "$@" ;;
    db)       cmd_db "$@" ;;
    shell)    cmd_shell "$@" ;;
    update)   cmd_update "$@" ;;
    health)   cmd_health "$@" ;;
    gpio)     cmd_gpio "$@" ;;
    relay)    cmd_relay "$@" ;;
    native)   cmd_native "$@" ;;
    backup)   cmd_backup "$@" ;;
    restore)  cmd_restore "$@" ;;
    sprint)   cmd_sprint "$@" ;;
    install)  cmd_install "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        error "Commande inconnue : $COMMAND"
        cmd_help
        exit 1
        ;;
esac
