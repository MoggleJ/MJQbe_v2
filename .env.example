# PostgreSQL
POSTGRES_USER=mjqbe
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=mjqbe
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API — Secrets uniquement (les autres paramètres sont dans config/config.yml)
# Générer avec : openssl rand -hex 32
SECRET_KEY=<your-secret-key>

# Mot de passe du compte admin créé au premier démarrage (seed).
# Si non défini, "admin" est utilisé — À CHANGER (via l'UI ou ici avant le 1er 'dev up').
MJQBE_ADMIN_PASSWORD=<initial-admin-password>

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Daemon
DAEMON_SOCKET=/run/mjqbe/daemon.sock

# Domaine web — normalement lu automatiquement depuis config/config.yml par le CLI dev
# Forcer ici seulement si tu n'utilises pas le CLI dev pour lancer docker compose
# Laisser vide = "_" (répond à toutes les requêtes, IP directe ou n'importe quel domaine)
# SERVER_NAME=mjqbe.example.com
