# PostgreSQL
POSTGRES_USER=mjqbe
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mjqbe

# API — Secrets uniquement (les autres paramètres sont dans config/config.yml)
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Daemon
DAEMON_SOCKET=/run/mjqbe/daemon.sock

# Domaine web — normalement lu automatiquement depuis config/config.yml par le CLI dev
# Forcer ici seulement si tu n'utilises pas le CLI dev pour lancer docker compose
# Laisser vide = "_" (répond à toutes les requêtes, IP directe ou n'importe quel domaine)
# SERVER_NAME=mjqbe.example.com
